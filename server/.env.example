# Copy this file to .env for local development.
# On Render, set these as Environment Variables in the dashboard instead.

# Postgres connection string. Render provides this automatically when you
# attach a Postgres database to your web service (Internal Database URL).
DATABASE_URL=postgres://user:password@localhost:5432/rollcall

# Set to "true" only if your Postgres provider requires SSL with a
# self-signed cert (Render's managed Postgres does).
DATABASE_SSL=true

# Random long string used to sign login sessions. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# The one and only super admin account, created automatically on first boot.
SUPER_ADMIN_EMAIL=you@lukholo.online
SUPER_ADMIN_PASSWORD=choose-a-strong-password

# VAPID keys for web push. Generate with:
#   cd server && npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@lukholo.online

# Port the server listens on. Render sets this for you automatically.
PORT=3000
